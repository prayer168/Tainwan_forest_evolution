{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["mode", "locale"],
  "properties": {
    "mode": { "type": "string", "enum": ["compact", "deepen"] },
    "locale": { "type": "string", "const": "zh-TW" },
    "target_minutes": { "type": "integer", "minimum": 20, "maximum": 120 },
    "focus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 50 }
    }
  },
  "allOf": [
    { "if": { "properties": { "mode": { "const": "compact" } } }, "then": { "required": ["target_minutes"] } },
    { "if": { "properties": { "mode": { "const": "deepen" } } }, "then": { "required": ["focus"] } }
  ],
  "additionalProperties": false
}
